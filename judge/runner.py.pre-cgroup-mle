#!/usr/bin/env python3

import json
import resource
import subprocess
import sys
import time


MAX_INPUT_BYTES = 16 * 1024 * 1024


def main():
    if len(sys.argv) < 2:
        print(
            json.dumps({
                "error": "missing command"
            }),
            file=sys.stderr,
        )
        return 2

    command = sys.argv[1:]

    # Đọc testcase input từ Podman trước khi chạy chương trình.
    input_data = sys.stdin.buffer.read(
        MAX_INPUT_BYTES + 1
    )

    if len(input_data) > MAX_INPUT_BYTES:
        print(
            "judge input exceeds limit",
            file=sys.stderr,
        )
        return 125

    started = time.monotonic_ns()

    try:
        completed = subprocess.run(
            command,
            input=input_data,
            stdout=sys.stdout.buffer,
            stderr=sys.stderr.buffer,
            check=False,
        )

        return_code = completed.returncode

    except Exception as error:
        print(
            f"runner error: {error}",
            file=sys.stderr,
        )
        return 125

    finally:
        ended = time.monotonic_ns()

        usage = resource.getrusage(
            resource.RUSAGE_CHILDREN
        )

        metadata = {
            "executionTimeMs": round(
                (ended - started) / 1_000_000,
                3,
            ),
            "memoryUsedKb": int(
                usage.ru_maxrss
            ),
        }

        print(
            "__ZUNY_META__"
            + json.dumps(
                metadata,
                separators=(",", ":"),
            ),
            file=sys.stderr,
        )

    return return_code


if __name__ == "__main__":
    raise SystemExit(main())
