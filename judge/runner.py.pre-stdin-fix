#!/usr/bin/env python3

import json
import resource
import subprocess
import sys
import time


def main():
    if len(sys.argv) < 2:
        print(
            json.dumps({
                "error": "missing command"
            }),
            file=sys.stderr,
        )
        return 2

    command = sys.argv[1:]

    started = time.monotonic_ns()

    try:
        completed = subprocess.run(
            command,
            stdin=sys.stdin,
            stdout=sys.stdout,
            stderr=sys.stderr,
            check=False,
        )
        return_code = completed.returncode

    except Exception as error:
        print(
            f"runner error: {error}",
            file=sys.stderr,
        )
        return 125

    finally:
        ended = time.monotonic_ns()

        usage = resource.getrusage(
            resource.RUSAGE_CHILDREN
        )

        metadata = {
            "executionTimeMs": round(
                (ended - started) / 1_000_000,
                3,
            ),
            "memoryUsedKb": int(
                usage.ru_maxrss
            ),
        }

        print(
            "__ZUNY_META__"
            + json.dumps(metadata),
            file=sys.stderr,
        )

    return return_code


if __name__ == "__main__":
    raise SystemExit(main())
