FROM docker.io/library/python:3.14-slim

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

ARG NODE_VERSION=24.18.0
ARG NODE_SHA256=55aa7153f9d88f28d765fcdad5ae6945b5c0f98a36881703817e4c450fa76742

RUN apt-get update \
    && apt-get install -y \
        --no-install-recommends \
        g++ \
        openjdk-21-jdk-headless \
        curl \
        xz-utils \
    && curl -fsSLO \
        "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz" \
    && echo "${NODE_SHA256}  node-v${NODE_VERSION}-linux-x64.tar.xz" \
        | sha256sum -c - \
    && tar -xJf \
        "node-v${NODE_VERSION}-linux-x64.tar.xz" \
        -C /usr/local \
        --strip-components=1 \
    && rm \
        "node-v${NODE_VERSION}-linux-x64.tar.xz" \
    && apt-get purge -y \
        curl \
        xz-utils \
    && rm -rf /var/lib/apt/lists/*

# Precompiled bits/stdc++.h cho C++23.
# Giảm thời gian compile submission nhưng không thay đổi source học sinh.
RUN mkdir -p /opt/zuny-pch/bits \
    && cp /usr/include/x86_64-linux-gnu/c++/14/bits/stdc++.h \
          /opt/zuny-pch/bits/stdc++.h \
    && g++ \
         -std=c++23 \
         -O2 \
         -pipe \
         -x c++-header \
         /opt/zuny-pch/bits/stdc++.h \
         -o /opt/zuny-pch/bits/stdc++.h.gch \
    && chmod -R a+rX /opt/zuny-pch

COPY runner.py /usr/local/bin/zuny-runner

RUN chmod 0555 /usr/local/bin/zuny-runner \
    && useradd \
        --create-home \
        --uid 10001 \
        --shell /usr/sbin/nologin \
        judge

USER judge

WORKDIR /workspace
