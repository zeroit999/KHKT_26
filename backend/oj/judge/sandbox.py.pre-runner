from dataclasses import dataclass
import subprocess


JUDGE_IMAGE = "localhost/zuny-judge:latest"


@dataclass
class SandboxResult:
    return_code: int | None
    stdout: str
    stderr: str
    timed_out: bool = False


def build_podman_command(
    workspace,
    command,
    *,
    memory_mb,
    timeout_seconds,
):
    memory_mb = max(
        32,
        int(memory_mb),
    )

    timeout_seconds = max(
        1,
        int(timeout_seconds),
    )

    return [
        "/usr/bin/podman",
        "run",
        "--rm",

        # Không cho source học sinh truy cập mạng.
        "--network=none",

        # Không cấp thêm Linux capabilities.
        "--cap-drop=ALL",

        "--security-opt=no-new-privileges",

        # Chặn fork bomb.
        "--pids-limit=64",

        # Giới hạn RAM container.
        f"--memory={memory_mb}m",
        f"--memory-swap={memory_mb}m",

        # Giới hạn CPU.
        "--cpus=1",

        # Root filesystem của image chỉ đọc.
        "--read-only",

        # Không truyền environment của host vào.
        "--env=HOME=/tmp",
        "--env=LANG=C.UTF-8",

        # /tmp riêng và có giới hạn.
        "--tmpfs=/tmp:rw,nosuid,nodev,size=64m",

        # Workspace của submission.
        "--volume",
        f"{workspace}:/workspace:rw,Z",

        "--workdir=/workspace",

        JUDGE_IMAGE,

        *command,
    ]


def run_in_sandbox(
    workspace,
    command,
    *,
    stdin_data="",
    memory_mb=256,
    timeout_seconds=2,
):
    podman_command = build_podman_command(
        workspace,
        command,
        memory_mb=memory_mb,
        timeout_seconds=timeout_seconds,
    )

    try:
        completed = subprocess.run(
            podman_command,
            input=str(stdin_data or ""),
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,

            # Đây là timeout của HOST worker,
            # không phụ thuộc code bên trong container.
            timeout=timeout_seconds,

            check=False,
        )

        return SandboxResult(
            return_code=completed.returncode,
            stdout=completed.stdout,
            stderr=completed.stderr,
        )

    except subprocess.TimeoutExpired as error:
        stdout = error.stdout or ""
        stderr = error.stderr or ""

        if isinstance(stdout, bytes):
            stdout = stdout.decode(
                "utf-8",
                errors="replace",
            )

        if isinstance(stderr, bytes):
            stderr = stderr.decode(
                "utf-8",
                errors="replace",
            )

        return SandboxResult(
            return_code=None,
            stdout=stdout,
            stderr=stderr,
            timed_out=True,
        )
