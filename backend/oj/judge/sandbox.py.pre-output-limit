from dataclasses import dataclass
import json
import os
import subprocess


JUDGE_IMAGE = "localhost/zuny-judge:latest"
META_PREFIX = "__ZUNY_META__"


@dataclass
class SandboxResult:
    return_code: int | None
    stdout: str
    stderr: str
    timed_out: bool = False
    execution_time_ms: float | None = None
    memory_used_kb: int | None = None
    memory_exceeded: bool = False


def build_podman_command(
    workspace,
    command,
    *,
    memory_mb,
    measured=False,
):
    memory_mb = max(
        32,
        int(memory_mb),
    )

    container_command = list(command)

    if measured:
        container_command = [
            "/usr/local/bin/zuny-runner",
            *container_command,
        ]

    return [
        "/usr/bin/podman",
        "run",
        "--rm",
        "--interactive",

        # Map UID/GID của worker host vào container.
        # Workspace tạm vẫn giữ quyền riêng tư, không cần chmod 777.
        "--userns=keep-id",

        # Chạy bằng chính UID/GID của Judge Worker.
        # Nhờ đó workspace mode 700 vẫn giữ riêng tư.
        "--user",
        f"{os.getuid()}:{os.getgid()}",

        "--network=none",
        "--cap-drop=ALL",
        "--security-opt=no-new-privileges",
        "--pids-limit=64",
        f"--memory={memory_mb}m",
        f"--memory-swap={memory_mb}m",
        "--cpus=1",
        "--read-only",
        "--env=HOME=/tmp",
        "--env=LANG=C.UTF-8",
        "--tmpfs=/tmp:rw,nosuid,nodev,size=64m",
        "--volume",
        f"{workspace}:/workspace:rw,Z",
        "--workdir=/workspace",
        JUDGE_IMAGE,
        *container_command,
    ]


def parse_metadata(stderr):
    clean_lines = []
    metadata = {}

    for line in str(
        stderr or ""
    ).splitlines():
        if line.startswith(META_PREFIX):
            raw = line[len(META_PREFIX):]

            try:
                parsed = json.loads(raw)

                if isinstance(parsed, dict):
                    metadata.update(parsed)

            except json.JSONDecodeError:
                clean_lines.append(line)

            continue

        clean_lines.append(line)

    clean_stderr = "\n".join(
        clean_lines
    )

    if stderr and str(stderr).endswith("\n"):
        if clean_stderr:
            clean_stderr += "\n"

    return clean_stderr, metadata


def run_in_sandbox(
    workspace,
    command,
    *,
    stdin_data="",
    memory_mb=256,
    timeout_seconds=2,
    measured=False,
):
    podman_command = build_podman_command(
        workspace,
        command,
        memory_mb=memory_mb,
        measured=measured,
    )

    try:
        completed = subprocess.run(
            podman_command,
            input=str(stdin_data or ""),
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=max(
                1.0,
                float(timeout_seconds),
            ),
            check=False,
        )

        stderr, metadata = parse_metadata(
            completed.stderr
        )

        execution_time_ms = metadata.get(
            "executionTimeMs"
        )

        memory_used_kb = metadata.get(
            "memoryUsedKb"
        )

        try:
            if execution_time_ms is not None:
                execution_time_ms = float(
                    execution_time_ms
                )
        except (TypeError, ValueError):
            execution_time_ms = None

        try:
            if memory_used_kb is not None:
                memory_used_kb = int(
                    memory_used_kb
                )
        except (TypeError, ValueError):
            memory_used_kb = None

        return SandboxResult(
            return_code=completed.returncode,
            stdout=completed.stdout,
            stderr=stderr,
            execution_time_ms=execution_time_ms,
            memory_used_kb=memory_used_kb,
            memory_exceeded=bool(
                metadata.get(
                    "memoryExceeded",
                    False,
                )
            ),
        )

    except subprocess.TimeoutExpired as error:
        stdout = error.stdout or ""
        stderr = error.stderr or ""

        if isinstance(stdout, bytes):
            stdout = stdout.decode(
                "utf-8",
                errors="replace",
            )

        if isinstance(stderr, bytes):
            stderr = stderr.decode(
                "utf-8",
                errors="replace",
            )

        stderr, metadata = parse_metadata(
            stderr
        )

        return SandboxResult(
            return_code=None,
            stdout=stdout,
            stderr=stderr,
            timed_out=True,
            execution_time_ms=metadata.get(
                "executionTimeMs"
            ),
            memory_used_kb=metadata.get(
                "memoryUsedKb"
            ),
        )
